# ADNoirBase — ortam değişkenleri şablonu
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# `.env` .gitignore'dadır; asla commit etmeyin.
#
#   cp .env.example .env
#
# Not: Çift alt çizgi (__) .NET konfigürasyonunda iç içe bölümleri ifade eder.
# Örneğin ConnectionStrings__PostgreSQL, appsettings.json'daki
# { "ConnectionStrings": { "PostgreSQL": ... } } değerini ezer.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=adnoirbase
POSTGRES_USER=adnoirbase
# Güçlü bir parola üretin: openssl rand -base64 24
POSTGRES_PASSWORD=

ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=adnoirbase;Username=adnoirbase;Password=

# ─── MongoDB ──────────────────────────────────────────────────────────────────
ConnectionStrings__MongoDB=mongodb://localhost:27017

# ─── JWT ──────────────────────────────────────────────────────────────────────
# En az 32 karakter olmalıdır; uygulama daha kısa bir anahtarla başlamaz.
# Üretmek için: openssl rand -base64 48
Jwt__SecretKey=
Jwt__Issuer=ADNoirBase
Jwt__Audience=ADNoirBase

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Virgülle değil, indeksli anahtarlarla verilir. Her origin için bir satır.
Cors__AllowedOrigins__0=http://localhost:3000

# ─── DbMigrator seed kullanıcısı ──────────────────────────────────────────────
# ADMIN_PASSWORD zorunludur; boş bırakılırsa migrator hata verip durur.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ─── Next.js arayüzü (ui/) ────────────────────────────────────────────────────
# Bu değerler ui/.env.local dosyasına aittir, ui/.env.local.example'a bakın.
