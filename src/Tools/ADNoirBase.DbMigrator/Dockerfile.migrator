FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY ADNoirBase.sln .
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/ src/

RUN dotnet restore src/Tools/ADNoirBase.DbMigrator/ADNoirBase.DbMigrator.csproj
RUN dotnet publish src/Tools/ADNoirBase.DbMigrator/ADNoirBase.DbMigrator.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "ADNoirBase.DbMigrator.dll"]
