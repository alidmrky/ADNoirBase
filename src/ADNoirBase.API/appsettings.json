{
  "ConnectionStrings": {
    "PostgreSQL": "",
    "MongoDB": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "ADNoirBase",
    "Audience": "ADNoirBase",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "MongoDb": {
    "DatabaseName": "adnoirbase"
  },
  "Bcrypt": {
    "WorkFactor": 12
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Authentication": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Notification": {
    "AppName": "ADNoirBase",
    "AppUrl": "http://localhost:3000",
    "UnsubscribeSecret": "",
    "Email": {
      "Provider": "Log",
      "FromAddress": "no-reply@localhost",
      "FromDisplayName": "ADNoirBase",
      "ReplyTo": null,
      "PickupDirectory": ".mail-drop",
      "Smtp": {
        "Host": "",
        "Port": 587,
        "Security": "StartTls",
        "UserName": "",
        "Password": "",
        "TimeoutSeconds": 30
      }
    },
    "Sms": {
      "Provider": "Log"
    },
    "Delivery": {
      "Enabled": true,
      "MaxAttempts": 5,
      "ThrottlePerSecond": 10,
      "PollSeconds": 5,
      "LockMinutes": 5,
      "RetryBaseSeconds": 30,
      "RetryMaxSeconds": 3600
    },
    "Attachments": {
      "MaxBytes": 10485760,
      "MaxCount": 10
    },
    "Campaigns": {
      "Enabled": true,
      "BatchSize": 500,
      "PollSeconds": 10,
      "MaxRecipients": 100000
    }
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithCorrelationId" ]
  },
  "AllowedHosts": "*"
}
